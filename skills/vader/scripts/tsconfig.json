{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "types": ["bun"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "core.ts",
    "git.ts",
    "model.ts",
    "gate.ts",
    "memory.ts",
    "plan.ts",
    "vader.ts",
    "vader.test.ts",
    "dogfood.test.ts"
  ]
}
